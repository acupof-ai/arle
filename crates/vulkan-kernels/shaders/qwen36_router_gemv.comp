#version 450
// ARLE Vulkan shader: Qwen3.6 MoE router / shared-gate F32 GEMV.
//
// Replaces the host `gemv_f32_host` for the MoE routers: `y[e] = Σ_c W[e,c]·x[c]`
// for an F32 weight `[n_out, hidden]` (GGUF row-major [out, in]) × `[hidden]`
// activation. The F32 router weight lives in a HOST_VISIBLE (write-combined)
// buffer, so reading it back to host was ~50-300 MB/s = ~15 ms/token across the
// 40 layers; on-device it reads at full device bandwidth (~µs). One thread per
// output row e sums the `hidden`-wide dot in ascending-c order (matching the
// host's serial sum). `apply_sigmoid` folds the shared-expert sigmoid gate
// (n_out = 1) so its scalar comes out device-side ready.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint n_out;          // output rows (n_expert for the router, 1 for shexp gate)
    uint hidden;         // contraction width
    uint apply_sigmoid;  // 1 = out = sigmoid(dot) (shared-expert gate)
} p;

layout(binding = 0) readonly buffer Input {
    float x[];
};
layout(binding = 1) readonly buffer Weight {
    float w[];
};
layout(binding = 2) writeonly buffer Output {
    float y[];
};

void main() {
    const uint e = gl_GlobalInvocationID.x;
    if (e >= p.n_out) {
        return;
    }
    const uint base = e * p.hidden;
    float sum = 0.0;
    for (uint c = 0u; c < p.hidden; ++c) {
        sum += w[base + c] * x[c];
    }
    y[e] = (p.apply_sigmoid != 0u) ? (1.0 / (1.0 + exp(-sum))) : sum;
}
