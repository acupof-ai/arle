#version 450
// ARLE Vulkan shader ported from crates/cuda-kernels/csrc/misc/conv1d.cu.
// Qwen3.5 depthwise conv1d includes SiLU and advances the per-slot ring.
//
// THROUGHPUT: the per-channel work is fully independent, so one thread per
// channel via `gl_GlobalInvocationID.x` packs a full 256-wide workgroup (was
// local_size_x=1 — one active lane per wave, ~1.5% utilization, 10240 single-
// thread workgroups). The body is unchanged; only the lane packing + dispatch
// (`ceil(num_channels/256)` workgroups) differ. Tail lanes self-mask on `c >= n`.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint num_channels;
    uint seq_len;
    uint kernel_size;
} p;

layout(binding = 0) readonly buffer XSeq {
    float x_seq[];
};
layout(binding = 1) readonly buffer ConvWeight {
    float conv_weight[];
};
layout(binding = 2) buffer ConvState {
    float conv_state[];
};
layout(binding = 3) buffer OutSeq {
    float out_seq[];
};

float silu(float x) {
    return x / (1.0 + exp(-x));
}

float round_to_bf16(float x) {
    const uint bits = floatBitsToUint(x);
    const uint lsb = (bits >> 16) & 1u;
    return uintBitsToFloat((bits + 0x7fffu + lsb) & 0xffff0000u);
}

void main() {
    const uint c = gl_GlobalInvocationID.x;
    if (c >= p.num_channels || p.kernel_size == 0) {
        return;
    }

    const uint state_width = p.kernel_size - 1;
    float old_state[8];
    for (uint i = 0; i < 8; ++i) {
        old_state[i] = 0.0;
    }
    for (uint i = 0; i < min(state_width, 8u); ++i) {
        old_state[i] = conv_state[c * state_width + i];
    }

    for (uint t = 0; t < p.seq_len; ++t) {
        float sum = 0.0;
        for (uint k = 0; k < p.kernel_size; ++k) {
            const int src_t = int(t) - int(state_width) + int(k);
            float value = 0.0;
            if (src_t < 0) {
                const int state_idx = int(state_width) + src_t;
                if (state_idx >= 0 && state_idx < 8) {
                    value = old_state[state_idx];
                }
            } else {
                value = x_seq[uint(src_t) * p.num_channels + c];
            }
            sum += value * conv_weight[c * p.kernel_size + k];
        }
        out_seq[t * p.num_channels + c] = silu(round_to_bf16(sum));
    }

    for (uint i = 0; i < state_width; ++i) {
        const int src_t = int(p.seq_len) - int(state_width) + int(i);
        if (src_t >= 0) {
            conv_state[c * state_width + i] = x_seq[uint(src_t) * p.num_channels + c];
        } else {
            const int state_idx = int(state_width) + src_t;
            conv_state[c * state_width + i] =
                state_idx >= 0 && state_idx < 8 ? old_state[state_idx] : 0.0;
        }
    }
}
