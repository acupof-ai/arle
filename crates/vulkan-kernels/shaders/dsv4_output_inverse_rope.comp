#version 450
// ARLE Vulkan shader ported from crates/cuda-kernels/csrc/misc/dsv4_attention.cu
// dsv4_output_inverse_rope_kernel. No standalone llama.cpp equivalent exists (MIT).

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint local_heads;
    uint head_dim;
    uint rope_dim;
    uint start_pos;
    float rope_base;
    uint orig_seq_len;
    float factor;
    float beta_fast;
    float beta_slow;
} p;

layout(binding = 0) readonly buffer In {
    float in_data[];
};
layout(binding = 1) writeonly buffer Out {
    float out_data[];
};

float rope_inv_freq(uint pair_idx) {
    const float inv = pow(p.rope_base, -(2.0 * float(pair_idx)) / float(p.rope_dim));
    if (p.orig_seq_len == 0) {
        return inv;
    }
    const float low_f = floor(float(p.rope_dim) * log(float(p.orig_seq_len) / (p.beta_fast * 6.283185307179586)) / (2.0 * log(p.rope_base)));
    const float high_f = ceil(float(p.rope_dim) * log(float(p.orig_seq_len) / (p.beta_slow * 6.283185307179586)) / (2.0 * log(p.rope_base)));
    const int low = max(0, int(low_f));
    const int high = min(max(0, int(p.rope_dim) - 1), int(high_f));
    const float denom = low == high ? 0.001 : float(high - low);
    const float ramp = clamp((float(pair_idx) - float(low)) / denom, 0.0, 1.0);
    const float smooth_weight = 1.0 - ramp;
    return inv / p.factor * (1.0 - smooth_weight) + inv * smooth_weight;
}

void apply_rope_pair(inout float a, inout float b, uint pair_idx, float sign) {
    const float angle = float(p.start_pos) * rope_inv_freq(pair_idx);
    const float c = cos(angle);
    const float s = sign * sin(angle);
    const float old_a = a;
    a = old_a * c - b * s;
    b = b * c + old_a * s;
}

void main() {
    const uint head = gl_GlobalInvocationID.x;
    if (head >= p.local_heads) {
        return;
    }
    const uint base = head * p.head_dim;
    for (uint d = 0; d < p.head_dim; ++d) {
        out_data[base + d] = in_data[base + d];
    }
    const uint rope_start = p.head_dim - min(p.rope_dim, p.head_dim);
    for (uint d = 0; d + 1 < p.rope_dim && rope_start + d + 1 < p.head_dim; d += 2) {
        float a = in_data[base + rope_start + d];
        float b = in_data[base + rope_start + d + 1];
        apply_rope_pair(a, b, d / 2, -1.0);
        out_data[base + rope_start + d] = a;
        out_data[base + rope_start + d + 1] = b;
    }
}
