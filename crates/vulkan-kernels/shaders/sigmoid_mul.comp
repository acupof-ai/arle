#version 450
// ARLE Vulkan shader: per-element sigmoid gate `out[i] = sigmoid(a[i]) * b[i]`.
//
// The Qwen3.5 full-attention block applies a per-head sigmoid gate to the
// attention output: `attn[h,d] *= sigmoid(gate[h,d])`, where `gate` is the
// second half of the gated q-projection (`q_full`'s `[query|gate]` layout).
// This replaces the host loop in `forward.rs::full_attention` so the gate runs
// device-resident between the flash-attn output and the o-proj GEMV.
//
// Bindings mirror the elementwise family (0=A gate, 1=B value, 2=D out) so it
// shares the 3-binding descriptor ring with add/rms_norm/swiglu/scaled_add.
// `out` may alias `b` (the forward writes the gated result back over `attn`):
// each thread reads a[i] and b[i] before writing out[i], so in-place is safe.
//
// One thread per element (256-wide workgroup); the host dispatches
// `ceil(n / 256)` workgroups.
//
// STRIDED GATE (batched prefill): the gate operand is the odd half of an
// interleaved `[query|gate]` block, so for a whole prefill chunk it is NOT
// contiguous with the value operand — `val` is a packed `[T][heads][head_dim]`
// attention output while the gate lives at `[T][heads][2*head_dim] + head_dim`.
// `inner` / `gate_stride` / `gate_off` map value element `i` to gate element
// `(i / inner) * gate_stride + gate_off + (i % inner)`, so the whole chunk gates
// in ONE dispatch. Decode passes `inner = gate_stride = n, gate_off = 0` (the
// caller already binds the head's gate sub-range), which reduces to `gate[i]`.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint n;
    uint inner;       // value elements per gathered gate row
    uint gate_stride; // gate elements between consecutive rows
    uint gate_off;    // gate element offset within a row
} p;

layout(binding = 0) readonly buffer A {
    float gate[];
};

layout(binding = 1) readonly buffer B {
    float val[];
};

layout(binding = 2) writeonly buffer D {
    float out_data[];
};

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.n) {
        return;
    }
    const uint row = idx / p.inner;
    const uint g = row * p.gate_stride + p.gate_off + (idx - row * p.inner);
    const float s = 1.0 / (1.0 + exp(-gate[g]));
    out_data[idx] = s * val[idx];
}
