#version 450
// ARLE Vulkan glue shader. No standalone q8_1 activation quantizer exists in
// llama.cpp's Vulkan corpus at d2462f8f; block layout follows ggml `block_q8_1`.

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_atomic_float : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint n_blocks;
} p;

layout(binding = 0) readonly buffer X {
    float data_x[];
};

struct block_q8_1 {
    f16vec2 ds;
    int8_t qs[32];
};

layout(binding = 1) writeonly buffer D {
    block_q8_1 data_d[];
};

shared float absmax;
shared float sum;

void main() {
    const uint block = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    if (block >= p.n_blocks) {
        return;
    }

    const float x = data_x[block * 32 + lane];
    if (lane == 0) {
        absmax = 0.0;
        sum = 0.0;
    }
    barrier();

    atomicAdd(absmax, abs(x));
    atomicAdd(sum, x);
    barrier();

    const float d = absmax == 0.0 ? 0.0 : absmax / 127.0;
    const int q = d == 0.0 ? 0 : int(round(clamp(x / d, -127.0, 127.0)));
    data_d[block].qs[lane] = int8_t(q);
    if (lane == 0) {
        data_d[block].ds = f16vec2(float16_t(d), float16_t(sum));
    }
}
