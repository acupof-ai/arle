#version 450
// ARLE Vulkan shader ported from crates/cuda-kernels/csrc/misc/dsv4_attention.cu
// dsv4_swa_attention_kernel. No standalone llama.cpp equivalent exists (MIT).

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint local_heads;
    uint num_tokens;
    uint head_dim;
    uint sliding_window;
    uint start_pos;
    uint sink_offset;
    float sm_scale;
    uint rope_dim;
    float rope_base;
    uint orig_seq_len;
    float factor;
    float beta_fast;
    float beta_slow;
    uint write_window_cache;
} p;

layout(binding = 0) readonly buffer Q {
    float q[];
};
layout(binding = 1) readonly buffer KNew {
    float k_new[];
};
layout(binding = 2) buffer Window {
    float window_cache[];
};
layout(binding = 3) readonly buffer Sink {
    float sink[];
};
layout(binding = 4) buffer Out {
    float out_data[];
};

float rope_inv_freq(uint pair_idx) {
    const float inv = pow(p.rope_base, -(2.0 * float(pair_idx)) / float(p.rope_dim));
    if (p.orig_seq_len == 0) {
        return inv;
    }
    const float low_f = floor(float(p.rope_dim) * log(float(p.orig_seq_len) / (p.beta_fast * 6.283185307179586)) / (2.0 * log(p.rope_base)));
    const float high_f = ceil(float(p.rope_dim) * log(float(p.orig_seq_len) / (p.beta_slow * 6.283185307179586)) / (2.0 * log(p.rope_base)));
    const int low = max(0, int(low_f));
    const int high = min(max(0, int(p.rope_dim) - 1), int(high_f));
    const float denom = low == high ? 0.001 : float(high - low);
    const float ramp = clamp((float(pair_idx) - float(low)) / denom, 0.0, 1.0);
    const float smooth_weight = 1.0 - ramp;
    return inv / p.factor * (1.0 - smooth_weight) + inv * smooth_weight;
}

void apply_rope_pair(inout float a, inout float b, uint pair_idx, uint abs_pos, float sign) {
    const float angle = float(abs_pos) * rope_inv_freq(pair_idx);
    const float c = cos(angle);
    const float s = sign * sin(angle);
    const float old_a = a;
    a = old_a * c - b * s;
    b = b * c + old_a * s;
}

float key_value(uint key_pos, uint col) {
    if (key_pos >= p.start_pos) {
        return k_new[(key_pos - p.start_pos) * p.head_dim + col];
    }
    return window_cache[(key_pos % p.sliding_window) * p.head_dim + col];
}

void main() {
    const uint row = gl_GlobalInvocationID.x;
    if (p.local_heads == 0 || p.head_dim == 0 || p.sliding_window == 0) {
        return;
    }
    const uint token = row / p.local_heads;
    const uint head = row - token * p.local_heads;
    if (token >= p.num_tokens || head >= p.local_heads) {
        return;
    }

    const uint abs_pos = p.start_pos + token;
    const uint n_ctx = min(abs_pos + 1, p.sliding_window);
    const uint local_width = p.local_heads * p.head_dim;
    const uint base = token * local_width + head * p.head_dim;
    const float sink_value = sink[p.sink_offset + head];
    float max_logit = sink_value;
    for (uint t = 0; t < n_ctx; ++t) {
        const uint abs_t = abs_pos + 1 - n_ctx + t;
        float dotv = 0.0;
        for (uint d = 0; d < p.head_dim; ++d) {
            dotv += q[base + d] * key_value(abs_t, d);
        }
        max_logit = max(max_logit, dotv * p.sm_scale);
    }

    float denom = exp(sink_value - max_logit);
    for (uint d = 0; d < p.head_dim; ++d) {
        out_data[base + d] = 0.0;
    }
    for (uint t = 0; t < n_ctx; ++t) {
        const uint abs_t = abs_pos + 1 - n_ctx + t;
        float dotv = 0.0;
        for (uint d = 0; d < p.head_dim; ++d) {
            dotv += q[base + d] * key_value(abs_t, d);
        }
        const float w = exp(dotv * p.sm_scale - max_logit);
        denom += w;
        for (uint d = 0; d < p.head_dim; ++d) {
            out_data[base + d] += w * key_value(abs_t, d);
        }
    }
    const float inv_denom = 1.0 / max(denom, 1.0e-20);
    const uint rope = min(p.rope_dim, p.head_dim);
    const uint rope_start = p.head_dim - rope;
    for (uint d = 0; d < rope_start; ++d) {
        out_data[base + d] *= inv_denom;
    }
    for (uint d = 0; d + 1 < rope; d += 2) {
        float a = out_data[base + rope_start + d] * inv_denom;
        float b = out_data[base + rope_start + d + 1] * inv_denom;
        apply_rope_pair(a, b, d / 2, abs_pos, -1.0);
        out_data[base + rope_start + d] = a;
        out_data[base + rope_start + d + 1] = b;
    }
    if ((rope & 1u) != 0u) {
        out_data[base + p.head_dim - 1] *= inv_denom;
    }
    if (p.write_window_cache != 0 && head == 0) {
        const uint cache_row = abs_pos % p.sliding_window;
        for (uint d = 0; d < p.head_dim; ++d) {
            window_cache[cache_row * p.head_dim + d] = k_new[token * p.head_dim + d];
        }
    }
}
