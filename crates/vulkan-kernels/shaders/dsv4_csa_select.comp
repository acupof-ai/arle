#version 450
// ARLE Vulkan shader ported from crates/cuda-kernels/csrc/misc/dsv4_attention.cu
// dsv4_csa_select_kernel. No standalone llama.cpp equivalent exists (MIT).

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint query_width;
    uint index_heads;
    uint index_dim;
    uint key_count;
    uint ratio;
    uint topk;
    uint start_pos;
    float score_scale;
} p;

layout(binding = 0) readonly buffer Query {
    float query[];
};
layout(binding = 1) readonly buffer Weights {
    float weights[];
};
layout(binding = 2) readonly buffer Keys {
    float keys[];
};
layout(binding = 3) buffer Selected {
    int selected[];
};

float score_key(uint token, uint key) {
    float score = 0.0;
    for (uint head = 0; head < p.index_heads; ++head) {
        float dotv = 0.0;
        const uint q_base = token * p.query_width + head * p.index_dim;
        const uint key_base = key * p.index_dim;
        for (uint d = 0; d < p.index_dim; ++d) {
            dotv += query[q_base + d] * keys[key_base + d];
        }
        const float weight = weights[token * p.index_heads + head] * p.score_scale;
        score += weight * max(dotv, 0.0);
    }
    return score;
}

void main() {
    const uint token = gl_GlobalInvocationID.x;
    const uint out_base = token * p.topk;
    for (uint k = 0; k < p.topk; ++k) {
        selected[out_base + k] = -1;
    }
    if (p.ratio == 0 || p.topk == 0) {
        return;
    }

    const uint abs_pos = p.start_pos + token;
    const uint available = min(p.key_count, abs_pos / p.ratio);
    if (available <= p.topk) {
        for (uint k = 0; k < p.topk; ++k) {
            selected[out_base + k] = k < available ? int(k) : -1;
        }
        return;
    }

    for (uint rank = 0; rank < p.topk; ++rank) {
        float best = -3.402823e38;
        int best_idx = -1;
        for (uint key = 0; key < available; ++key) {
            bool used = false;
            for (uint prev = 0; prev < rank; ++prev) {
                used = used || selected[out_base + prev] == int(key);
            }
            if (used) {
                continue;
            }
            const float s = score_key(token, key);
            if (s > best) {
                best = s;
                best_idx = int(key);
            }
        }
        selected[out_base + rank] = best_idx;
    }
}
