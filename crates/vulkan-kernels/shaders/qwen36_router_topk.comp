#version 450
// ARLE Vulkan shader: Qwen3.6 MoE router top-k selection (PARALLEL).
//
// Replaces the host `qwen36_topk_routes`: softmax-over-ALL experts, top-k by
// softmax prob, weights = the selected probs (optionally renormalized to sum 1).
//
// ONE workgroup of `BLOCK` threads (one expert per lane for n_expert<=BLOCK):
// parallel max-reduction, parallel Σexp, then `top_k` rounds of parallel
// argmax-and-mask, finally the renorm. The earlier version ran this single-
// threaded (local_size_x=1) — pathologically slow on the GPU (~428µs/call,
// ~46% of MoE decode); the work is trivially parallel.
//
// KEY FACT: softmax is monotonic, so top-k by prob == top-k by raw logit. Select
// by logit (argmax with strict `>`, ties → LOWER expert id, matching the host's
// stable descending sort), then weights = exp(logit-max)/sum on the kept k.
#define BLOCK 256
layout(local_size_x = BLOCK, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint n_expert;   // total experts (<= BLOCK)
    uint top_k;      // experts to keep per token
    uint norm_topk;  // 1 = renormalize kept weights to sum 1 (clamp F16_MIN)
} p;

layout(binding = 0) readonly buffer Logits {
    float logits[];
};
layout(binding = 1) writeonly buffer Ids {
    int ids[];
};
layout(binding = 2) writeonly buffer Weights {
    float weights[];
};

const float NEG_INF = -3.4e38;
const float F16_MIN = 6.103516e-5; // 2^-14, matches llama.cpp ggml_clamp floor

shared float red_f[BLOCK]; // reduction scratch (values)
shared int red_i[BLOCK];   // reduction scratch (indices, for argmax tie-break)
shared int sel[64];        // selected expert ids (top_k <= 64)
shared float g_max;        // softmax max
shared float g_sum;        // softmax denominator

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint n = p.n_expert;
    const uint k = min(p.top_k, n);
    const float my_logit = (tid < n) ? logits[tid] : NEG_INF;

    // 1. max over all logits.
    red_f[tid] = my_logit;
    barrier();
    for (uint s = BLOCK / 2u; s > 0u; s >>= 1) {
        if (tid < s) {
            red_f[tid] = max(red_f[tid], red_f[tid + s]);
        }
        barrier();
    }
    if (tid == 0u) {
        g_max = red_f[0];
    }
    barrier();
    const float maxv = g_max;

    // 2. Σ exp(logit - max) over all experts.
    red_f[tid] = (tid < n) ? exp(my_logit - maxv) : 0.0;
    barrier();
    for (uint s = BLOCK / 2u; s > 0u; s >>= 1) {
        if (tid < s) {
            red_f[tid] += red_f[tid + s];
        }
        barrier();
    }
    if (tid == 0u) {
        g_sum = red_f[0];
    }
    barrier();
    const float sumv = g_sum;

    // 3. top-k by logit (== by prob). Each round: parallel argmax over the
    //    not-yet-selected experts; strict `>` keeps the lower id on ties.
    bool taken = false;
    for (uint j = 0u; j < k; ++j) {
        red_f[tid] = (tid < n && !taken) ? my_logit : NEG_INF;
        red_i[tid] = int(tid);
        barrier();
        for (uint s = BLOCK / 2u; s > 0u; s >>= 1) {
            if (tid < s) {
                float a = red_f[tid];
                float b = red_f[tid + s];
                int ai = red_i[tid];
                int bi = red_i[tid + s];
                // pick the larger value; on a tie keep the lower index.
                if (b > a || (b == a && bi < ai)) {
                    red_f[tid] = b;
                    red_i[tid] = bi;
                }
            }
            barrier();
        }
        int best = red_i[0];
        if (tid == uint(best)) {
            taken = true;
        }
        if (tid == 0u) {
            sel[j] = best;
        }
        barrier();
    }

    // 4. weights = selected softmax probs, optionally renormalized to sum 1.
    if (tid == 0u) {
        float kept_sum = 0.0;
        for (uint j = 0u; j < k; ++j) {
            kept_sum += exp(logits[sel[j]] - maxv) / sumv;
        }
        float denom = (p.norm_topk != 0u) ? max(kept_sum, F16_MIN) : 1.0;
        for (uint j = 0u; j < k; ++j) {
            ids[j] = sel[j];
            weights[j] = (exp(logits[sel[j]] - maxv) / sumv) / denom;
        }
    }
}
