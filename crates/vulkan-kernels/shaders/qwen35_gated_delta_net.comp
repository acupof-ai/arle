#version 450
// ARLE Vulkan shader ported from crates/cuda-kernels/csrc/misc/gated_delta_rule.cu.
// Serial fallback for Qwen3.5 gated-delta recurrent decode/prefill semantics.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint num_key_heads;
    uint num_value_heads;
    uint key_dim;
    uint val_dim;
    uint seq_len;
} p;

layout(binding = 0) readonly buffer Qkv {
    float qkv[];
};
layout(binding = 1) readonly buffer BProj {
    float b_proj[];
};
layout(binding = 2) readonly buffer AProj {
    float a_proj[];
};
layout(binding = 3) readonly buffer DtBias {
    float dt_bias[];
};
layout(binding = 4) readonly buffer ALog {
    float a_log[];
};
layout(binding = 5) buffer State {
    float state[];
};
layout(binding = 6) buffer Output {
    float output_data[];
};

float softplus(float x) {
    return x > 20.0 ? x : log(1.0 + exp(x));
}

float sigmoid(float x) {
    return 1.0 / (1.0 + exp(-x));
}

float q_value(uint token_base, uint k_head, uint j, float q_norm) {
    return qkv[token_base + k_head * p.key_dim + j] * q_norm * inversesqrt(float(p.key_dim));
}

float k_value(uint token_base, uint q_dim_total, uint k_head, uint j, float k_norm) {
    return qkv[token_base + q_dim_total + k_head * p.key_dim + j] * k_norm;
}

void main() {
    const uint v_head = gl_GlobalInvocationID.x;
    if (v_head >= p.num_value_heads || p.num_key_heads == 0 || p.key_dim == 0 || p.val_dim == 0) {
        return;
    }

    // GQA key-head mapping: llama.cpp expands the key heads to value heads with
    // `ggml_repeat`, which TILES rather than block-broadcasts — value head
    // `v_head` reads key head `v_head % num_key_heads`, NOT
    // `v_head * num_key_heads / num_value_heads`. The block-broadcast form
    // scrambled every linear layer's q/k (see the host oracle in
    // forward.rs::linear_attention).
    const uint k_head = v_head % p.num_key_heads;
    const uint q_dim_total = p.key_dim * p.num_key_heads;
    const uint k_dim_total = q_dim_total;
    const uint qkv_stride = q_dim_total + k_dim_total + p.val_dim * p.num_value_heads;
    const uint out_stride = p.num_value_heads * p.val_dim;
    const uint state_base = v_head * p.key_dim * p.val_dim;

    for (uint token = 0; token < p.seq_len; ++token) {
        const uint token_base = token * qkv_stride;
        float q_sumsq = 0.0;
        float k_sumsq = 0.0;
        for (uint j = 0; j < p.key_dim; ++j) {
            const float qv = qkv[token_base + k_head * p.key_dim + j];
            const float kv = qkv[token_base + q_dim_total + k_head * p.key_dim + j];
            q_sumsq += qv * qv;
            k_sumsq += kv * kv;
        }
        const float q_norm = inversesqrt(q_sumsq + 1.0e-12);
        const float k_norm = inversesqrt(k_sumsq + 1.0e-12);

        const float a_val = a_proj[token * p.num_value_heads + v_head];
        const float b_val = b_proj[token * p.num_value_heads + v_head];
        // GGUF `ssm_a` already stores A = -exp(A_log) (the converter pre-applied
        // the -exp; verified negative on-box). So the log-decay is
        // A * softplus(dt), NOT -exp(A) * softplus(dt). Matches the host oracle
        // and llama.cpp delta-net-base.cpp (`g = ggml_exp(softplus * ssm_a)`).
        const float exp_g = exp(a_log[v_head] * softplus(a_val + dt_bias[v_head]));
        const float beta = sigmoid(b_val);

        for (uint val = 0; val < p.val_dim; ++val) {
            const float v_val = qkv[token_base + q_dim_total + k_dim_total + v_head * p.val_dim + val];
            float kv_mem = 0.0;
            for (uint j = 0; j < p.key_dim; ++j) {
                const uint state_idx = state_base + j * p.val_dim + val;
                const float decayed = state[state_idx] * exp_g;
                state[state_idx] = decayed;
                kv_mem += decayed * k_value(token_base, q_dim_total, k_head, j, k_norm);
            }

            const float delta = (v_val - kv_mem) * beta;
            float acc_out = 0.0;
            for (uint j = 0; j < p.key_dim; ++j) {
                const uint state_idx = state_base + j * p.val_dim + val;
                const float updated =
                    state[state_idx] + delta * k_value(token_base, q_dim_total, k_head, j, k_norm);
                state[state_idx] = updated;
                acc_out += updated * q_value(token_base, k_head, j, q_norm);
            }
            output_data[token * out_stride + v_head * p.val_dim + val] = acc_out;
        }
    }
}
