#version 450
// ARLE Vulkan glue shader; llama.cpp d2462f8f has generic GLU plumbing but no
// separate GeGLU entrypoint.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint n;
} p;

layout(binding = 0) readonly buffer Gate {
    float data_gate[];
};

layout(binding = 1) readonly buffer Up {
    float data_up[];
};

layout(binding = 2) writeonly buffer D {
    float data_d[];
};

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    const float x = data_gate[i];
    const float t = 0.7978845608028654 * (x + 0.044715 * x * x * x);
    const float gelu = 0.5 * x * (1.0 + tanh(t));
    data_d[i] = gelu * data_up[i];
}
