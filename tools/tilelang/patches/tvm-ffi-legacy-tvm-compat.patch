diff --color -ur a/python/tvm_ffi/registry.py b/python/tvm_ffi/registry.py
--- a/python/tvm_ffi/registry.py	2022-11-09 20:37:21
+++ b/python/tvm_ffi/registry.py	2026-07-02 14:18:21
@@ -399,6 +399,12 @@
 def _add_class_attrs(type_cls: type, type_info: TypeInfo) -> type:
     for field in type_info.fields:
         name = field.name
+        if name in ("__dict__", "__weakref__"):
+            # ARLE patch: not writable on types. Old bundled TVMs (tilelang
+            # <=0.1.11) name DictAttrs' storage field `__dict__`; 0.1.11's
+            # `hasattr` guard skipped it, 0.1.12's own-attrs check does not
+            # (tile-ai/tilelang#2367, second surface).
+            continue
         if name not in type_cls.__dict__:  # skip attributes defined directly on this class
             setattr(type_cls, name, field.as_property(type_cls))
     has_ffi_init = False
diff --color -ur a/src/ffi/object.cc b/src/ffi/object.cc
--- a/src/ffi/object.cc	2022-11-09 20:37:21
+++ b/src/ffi/object.cc	2026-07-02 13:37:13
@@ -322,10 +322,13 @@
     column->begin_index = 0;
     Any& slot = column->data_[type_index - column->begin_index];
     if (slot.type_index() != kTVMFFINone) {
-      TVM_FFI_THROW(RuntimeError)
-          << "TypeAttr `" << name_str << "` is already registered for type index " << type_index
-          << ". To update the stored value, register a mutable container (e.g., Dict/List) "
-          << "once and mutate it in place on subsequent calls.";
+      // ARLE patch (first-wins): tolerate duplicate TypeAttr registration.
+      // tvm-ffi >=0.1.12 registers builtin entries the bundled TVM of older
+      // consumers (tilelang 0.1.11) still registers at load; the duplicate
+      // aborted `import tilelang` (tile-ai/tilelang#2367). The first (ffi)
+      // registration stays authoritative; genuinely new entries hit an empty
+      // slot and register normally.
+      return;
     }
     slot = value_view;
   }
