#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# A push from a WORKTREE exports GIT_DIR=<repo>/.git/worktrees/<name> to this
# hook (a push from the main checkout exports none, which is why probing there
# showed nothing). Its basename is the worktree name, not ".git", and git
# decides bare-vs-not by that basename — so any `git init` in a subprocess
# below here reinitializes the SHARED config as bare and every worktree then
# fails with "this operation must be run in a work tree". Disown at the
# boundary; the checks below discover the repo from the working directory.
while IFS='=' read -r name _; do
    case "$name" in GIT_*) unset "$name" ;; esac
done < <(env)

# The disown above is the fix; this log stays as its ongoing proof, outside
# the repo so a checkout cannot lose it.
BARE_LOG="${TMPDIR:-/tmp}/arle-core-bare.log"
bare_now() { git --git-dir="${REPO_ROOT}/.git" config core.bare 2>/dev/null || echo "?"; }
printf '%s enter pid=%s bare=%s\n' "$(date -u +%FT%TZ)" "$$" "$(bare_now)" >> "$BARE_LOG"
trap 'printf "%s exit  pid=%s bare=%s\n" "$(date -u +%FT%TZ)" "$$" "$(bare_now)" >> "$BARE_LOG"' EXIT

if [[ "${ARLE_SKIP_PRE_PUSH:-${AGENT_INFER_SKIP_PRE_PUSH:-0}}" == "1" ]]; then
    echo "[pre-push] ARLE_SKIP_PRE_PUSH=1; skipping (legacy AGENT_INFER_SKIP_PRE_PUSH also works)"
    exit 0
fi

# Not exec: exec replaces this process and discards the EXIT trap above, so the
# detector never recorded the state the checks left behind.
"${REPO_ROOT}/scripts/pre_push_checks.sh"
