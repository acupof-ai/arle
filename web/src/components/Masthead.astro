---
import type { TopNavLink } from "../data/content.ts";

interface Props {
  left: string;
  links: TopNavLink[];
  /** Bordered language-switch link rendered first in the nav. */
  lang?: TopNavLink;
}
const { left, links, lang } = Astro.props;
---
<header class="masthead">
  <span class="left">{left}</span>
  <nav class="right" aria-label="primary">
    {lang && <a class="lang" href={lang.href}>{lang.label}</a>}
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>
<style>
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 14px;
    margin-bottom: 88px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .left {
    color: var(--ink);
    font-weight: 700;
    flex: none;
  }
  .right {
    display: flex;
    align-items: baseline;
    gap: 22px;
    flex-wrap: nowrap;
    flex: none;
    white-space: nowrap;
  }
  .right a {
    color: inherit;
    text-decoration: none;
    transition: color var(--t-base);
  }
  .right a:hover { color: var(--ink); }
  .right a.lang {
    border: 1px solid var(--line);
    color: var(--ink-soft);
    padding: 3px 10px;
    letter-spacing: 0.14em;
    transition: border-color var(--t-base), color var(--t-base);
  }
  .right a.lang:hover { border-color: var(--ink); color: var(--ink); }

  @media (max-width: 760px) {
    /* flex:none keeps the nav at max-content even with wrap enabled —
       let it shrink so the links actually wrap on narrow viewports. */
    .right {
      flex: 1 1 auto;
      min-width: 0;
      flex-wrap: wrap;
      white-space: normal;
      gap: 10px 16px;
      justify-content: flex-end;
    }
  }
</style>
