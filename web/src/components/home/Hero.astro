---
import type { Locale } from "../../data/content.ts";

interface Props {
  hero: Locale["hero"];
}
const { hero } = Astro.props;
---
<section class="hero" aria-label="banner">
  <div class="kicker">{hero.kicker}</div>

  <div class="lockup" aria-label="arle">
    <svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M 50 18 L 50 58 L 40 58 L 40 52 Q 33 60 21 58 Q 6 55 6 40 Q 6 27 20 25 L 40 25 L 40 22 Q 40 18 34 18 L 14 18 L 14 10 L 36 10 Q 50 10 50 18 Z M 40 33 L 24 34 Q 16 35 16 41 Q 16 48 25 48 Q 36 48 40 42 Z"/></svg><span class="rest">rle</span><span class="caret" aria-hidden="true"></span>
  </div>

  <h1 set:html={hero.headline} />
  <p class="lede" set:html={hero.lede} />

  <div class="signals" aria-label="status chips">
    {hero.signals.map((s) => (
      <span class="sig">
        {s.dot && <span class={`pulse ${s.dot}`} aria-hidden="true" />}
        <span set:html={s.html} />
      </span>
    ))}
  </div>

  <div class="ctas">
    {hero.ctas.map((c, i) => (
      <a class={i === 0 ? "primary" : "secondary"} href={c.href}>{c.label}</a>
    ))}
  </div>

  <div class="terminal" aria-hidden="false">
    <div class="bar">
      <span><span class="dots"><i></i><i></i><i></i></span>{hero.terminal.title}</span>
      <span>{hero.terminal.cwd}</span>
    </div>
    <pre>{hero.terminal.lines.map((line, i) => (
      <span class="tline" style={`--i: ${i}`} set:html={line === "" ? "&nbsp;" : line} />
    ))}</pre>
  </div>
</section>
<style>
  .kicker {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .kicker::after { content: ""; flex: 1; border-top: 1px solid var(--line); }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 36px;
    color: var(--ink);
  }
  /* Cancel the glyph path's right-side viewBox padding so it reads "arle". */
  .lockup svg { margin-right: -6px; flex: none; }
  .lockup .rest { line-height: 1; }
  .lockup .caret {
    display: inline-block;
    width: 0.42ch;
    height: 0.78em;
    background: var(--coral);
    margin-left: 6px;
    animation: lockup-blink 1.1s steps(2) infinite;
  }
  @keyframes lockup-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .lockup .caret { animation: none; } }

  .hero h1 {
    margin: 0 0 36px;
    font-size: clamp(56px, 9vw, 112px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.98;
    text-wrap: balance;
    color: var(--ink);
  }
  .hero h1 :global(.magic) {
    position: relative;
    white-space: nowrap;
  }
  .hero h1 :global(.magic)::after {
    content: "";
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    top: 54%;
    border-top: 0.06em solid var(--coral);
    transform: rotate(-1.5deg) scaleX(0);
    transform-origin: left center;
    animation: strike 0.5s cubic-bezier(0.6, 0, 0.3, 1) 0.7s forwards;
  }
  @keyframes strike { to { transform: rotate(-1.5deg) scaleX(1); } }
  .hero h1 :global(.quiet) { color: var(--ink-dim); }

  .lede {
    margin: 0 0 28px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink);
    max-width: 58ch;
  }
  .lede :global(b) { font-weight: 700; }
  .lede :global(em) { font-style: normal; color: var(--ink-soft); }

  .signals {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0 0 36px;
    font-size: 12px;
    color: var(--ink-soft);
  }
  .sig {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .sig :global(b) { color: var(--ink); font-weight: 600; }
  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    display: inline-block;
    flex: none;
    position: relative;
  }
  /* The name promised a pulse; give the live dots a ping halo. dim = idle,
     so it stays still. */
  .pulse.ok::after,
  .pulse.warn::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    0%   { transform: scale(1); opacity: 0.6; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
  .pulse.warn { background: var(--warn); }
  .pulse.dim  { background: var(--ink-dim); }

  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }
  .ctas a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    line-height: 1;
    white-space: nowrap;
    padding: 13px 18px;
    border: 1px solid var(--ink);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--t-base), color var(--t-base);
  }
  .ctas a.primary {
    background: var(--ink);
    color: var(--paper);
  }
  .ctas a.primary:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .ctas a.secondary:hover { background: var(--paper-dim); }

  .terminal {
    border: 1px solid var(--ink);
    background: var(--console);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
    overflow: hidden;
  }
  .terminal .bar {
    background: var(--console-2);
    color: rgba(255, 255, 255, 0.55);
    border-bottom: 1px solid #2a2a2a;
    padding: 9px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .terminal .bar .dots {
    display: inline-flex;
    gap: 6px;
    margin-right: 14px;
  }
  .terminal .bar .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3a3a;
    display: inline-block;
  }
  /* Override any host stylesheet defaults so the dark terminal stays
     dark — `!important` defeats cascade-order surprises. */
  .terminal pre {
    margin: 0 !important;
    padding: 16px 18px !important;
    overflow-x: auto;
    background: transparent !important;
    border: none !important;
    color: rgba(255, 255, 255, 0.92) !important;
    font-size: 13px !important;
    line-height: 1.7 !important;
    white-space: pre;
  }
  .terminal pre :global(.p)    { color: rgba(255, 255, 255, 0.45); user-select: none; padding-right: 8px; }
  .terminal pre :global(.c)    { color: rgba(255, 255, 255, 0.42); }
  .terminal pre :global(.ok)   { color: #4ADE80; }
  .terminal pre :global(.warn) { color: #FBBF24; }
  .terminal pre :global(.k)    { color: #93C5FD; }
  .terminal pre :global(.out)  { color: rgba(255, 255, 255, 0.92); }
  .terminal pre :global(.dim)  { color: rgba(255, 255, 255, 0.55); }
  .terminal pre :global(b)     { color: #fff; font-weight: 700; }
  .terminal pre :global(.caret) {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    background: var(--coral);
    vertical-align: -2px;
    margin-left: 6px;
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* Each doctor line prints in sequence — a terminal filling in, not a
     wall of text. `--i` sets the stagger; the last line carries the caret. */
  .terminal .tline {
    display: block;
    white-space: pre;
    opacity: 0;
    animation: tline-in 0.26s ease forwards;
    animation-delay: calc(0.62s + var(--i) * 0.11s);
  }
  @keyframes tline-in {
    from { opacity: 0; transform: translateY(3px); }
    to   { opacity: 1; transform: none; }
  }

  /* Entrance cascade — the lockup builds top-down before the fold. */
  .kicker, .lockup, .hero h1, .lede, .signals, .ctas, .terminal {
    animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .kicker   { animation-delay: 0.00s; }
  .lockup   { animation-delay: 0.06s; }
  .hero h1  { animation-delay: 0.13s; }
  .lede     { animation-delay: 0.21s; }
  .signals  { animation-delay: 0.29s; }
  .ctas     { animation-delay: 0.36s; }
  .terminal { animation-delay: 0.44s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal pre :global(.caret) { animation: none; }
    .hero h1 :global(.magic)::after { animation: none; transform: rotate(-1.5deg); }
    .pulse.ok::after, .pulse.warn::after { animation: none; opacity: 0; }
    .terminal .tline,
    .kicker, .lockup, .hero h1, .lede, .signals, .ctas, .terminal {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .hero h1 { font-size: clamp(40px, 11vw, 56px); }
  }
</style>
